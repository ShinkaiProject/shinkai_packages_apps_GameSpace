<?xml version="1.0" encoding="utf-8"?>
<!-- Session row (middle of the grouped list): tonal card, ripple on touch, tinted while selected -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">

    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/sessionItemSelected" />
                    <corners
                        android:topLeftRadius="@dimen/stats_item_corner_inner"
                        android:topRightRadius="@dimen/stats_item_corner_inner"
                        android:bottomLeftRadius="@dimen/stats_item_corner_inner"
                        android:bottomRightRadius="@dimen/stats_item_corner_inner" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accentInactive" />
                    <corners
                        android:topLeftRadius="@dimen/stats_item_corner_inner"
                        android:topRightRadius="@dimen/stats_item_corner_inner"
                        android:bottomLeftRadius="@dimen/stats_item_corner_inner"
                        android:bottomRightRadius="@dimen/stats_item_corner_inner" />
                </shape>
            </item>
        </selector>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
            <corners
                android:topLeftRadius="@dimen/stats_item_corner_inner"
                android:topRightRadius="@dimen/stats_item_corner_inner"
                android:bottomLeftRadius="@dimen/stats_item_corner_inner"
                android:bottomRightRadius="@dimen/stats_item_corner_inner" />
        </shape>
    </item>
</ripple>
