<?xml version="1.0" encoding="utf-8"?>
<!-- The handle of the preset editor's sliders: a thin bar with round ends. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="@dimen/display_slider_handle_width"
        android:height="@dimen/display_slider_handle_height" />
    <corners android:radius="@dimen/display_slider_handle_width" />
    <solid android:color="?android:attr/colorAccent" />
</shape>
