<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="118dp"
    android:layout_marginStart="8dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#FF1A1A1A"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/media_art_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/media_art_scrim" />

        <View
            android:id="@+id/media_color_wash"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="28dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/media_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:singleLine="true"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#FFFFFFFF"
                        android:text="@string/media_no_session" />

                    <TextView
                        android:id="@+id/media_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textSize="11sp"
                        android:textColor="#CCFFFFFF" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/media_play_pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="4dp"
                    android:padding="10dp"
                    android:background="@drawable/media_button_bg"
                    android:src="@drawable/ic_media_play"
                    app:tint="#FF1A1A1A" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/media_prev"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_media_prev"
                    app:tint="#FFFFFFFF" />

                <SeekBar
                    android:id="@+id/media_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:progressDrawable="@drawable/slider_track"
                    android:thumb="@drawable/slider_thumb"
                    android:thumbOffset="0dp"
                    android:splitTrack="false"
                    android:background="@null" />

                <ImageView
                    android:id="@+id/media_next"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_media_next"
                    app:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/media_like"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_media_like_border"
                    app:tint="#FFFFFFFF" />

                <ImageView
                    android:id="@+id/media_repeat"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_media_repeat"
                    app:tint="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/media_source_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerInside" />
    </FrameLayout>
</androidx.cardview.widget.CardView>
