<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="1dp"
    android:background="@drawable/bg_grouped_item_middle"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <!-- Only for tiles in the panel: touch and drag to reorder -->
    <ImageView
        android:id="@+id/tile_handle"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:contentDescription="@string/tile_layout_drag"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_drag_handle" />

    <ImageView
        android:id="@+id/tile_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_tile_icon"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:tint="?android:attr/textColorPrimary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tile_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="?android:textAppearanceMedium" />

        <TextView
            android:id="@+id/tile_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="?android:textAppearanceSmall"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/tile_action"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:scaleType="fitCenter" />

</LinearLayout>
