android_app {
    name: "GameSpace",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    resource_dirs: ["res"],
    srcs: [
        "java/**/*.java",
        "java/**/*.kt",
        "java/**/*.aidl",
    ],
    aidl: {
        local_include_dirs: ["java"],
    },
    static_libs: [
        "androidx.core_core-ktx",
        "androidx.activity_activity-compose",
        "androidx.compose.runtime_runtime",
        "androidx.compose.foundation_foundation",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.material3_material3",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.lifecycle_lifecycle-viewmodel-ktx",
        "androidx.savedstate_savedstate-ktx",
        "androidx.preference_preference",
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "gson",
        "hilt_android",
    ],
    kotlincflags: [
        "-opt-in=kotlin.Experimental",
        "-opt-in=kotlin.ExperimentalStdlibApi",
        "-opt-in=androidx.compose.material3.ExperimentalMaterial3Api",
        "-opt-in=androidx.compose.foundation.ExperimentalFoundationApi",
    ],
    plugins: [
        "dagger2-compiler",
        "androidx.compose.compiler_compiler-hosted",
    ],

    required: [
        "ANGLE",
        "privapp_whitelist_com.android.gamespace.xml"
    ],
}

prebuilt_etc_xml {
    name: "privapp_whitelist_com.android.gamespace.xml",
    src: "privapp_whitelist_com.android.gamespace.xml",
    system_ext_specific: true,
    filename_from_src: true,
    sub_dir: "permissions",
}
