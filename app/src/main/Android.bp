android_app {
    name: "GameSpace",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    resource_dirs: ["res"],
    srcs: [
        "java/**/*.java",
        "java/**/*.kt",
        "java/**/*.aidl",
    ],
    aidl: {
        local_include_dirs: ["java"],
    },
    // The Compose compiler plugin is not listed under "plugins": Soong adds it by itself to a module
    // that has "androidx.compose.runtime_runtime" in static_libs (keep that entry).
    // ASSUMPTION: the other androidx module names follow the usual AOSP prebuilts/sdk naming. If one
    // is reported as undefined, compare it with the Android.bp of another Compose app in the tree.
    static_libs: [
        "androidx.core_core-ktx",
        "androidx.activity_activity-compose",
        "androidx.compose.animation_animation",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material_material-ripple",
        "androidx.compose.material3_material3",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.savedstate_savedstate-ktx",
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "gson",
        "hilt_android",
        "lottie",
    ],
    kotlincflags: [
        "-opt-in=kotlin.Experimental",
        "-opt-in=kotlin.ExperimentalStdlibApi",
    ],
    plugins: [
        "dagger2-compiler",
    ],

    required: [
        "ANGLE",
        "privapp_whitelist_com.android.gamespace.xml"
    ],
}

prebuilt_etc_xml {
    name: "privapp_whitelist_com.android.gamespace.xml",
    src: "privapp_whitelist_com.android.gamespace.xml",
    system_ext_specific: true,
    filename_from_src: true,
    sub_dir: "permissions",
}
