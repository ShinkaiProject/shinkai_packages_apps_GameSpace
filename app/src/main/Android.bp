android_app {
    name: "GameSpace",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
    manifest: "AndroidManifest.xml",
    certificate: "platform",
    resource_dirs: ["res"],
    defaults: [
        "SettingsLibDefaults",
    ],
    srcs: [
        "java/**/*.java",
        "java/**/*.kt",
        "java/**/*.aidl",
    ],
    aidl: {
        local_include_dirs: ["java"],
    },
    static_libs: [
        "androidx.core_core-ktx",
        "androidx.appcompat_appcompat",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
        "com.google.android.material_material",
        "kotlin-stdlib",
        "kotlinx-coroutines-android",
        "gson",
        "hilt_android",
        "custom-preference",
        "androidx.compose.runtime_runtime",
        "androidx.compose.runtime_runtime-saveable",
        "androidx.compose.animation_animation",
        "androidx.compose.animation_animation-core",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-geometry",
        "androidx.compose.ui_ui-graphics",
        "androidx.compose.ui_ui-text",
        "androidx.compose.ui_ui-unit",
        "androidx.compose.foundation_foundation",
        "androidx.compose.foundation_foundation-layout",
        "androidx.compose.material3_material3",
        "androidx.lifecycle_lifecycle-runtime",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.lifecycle_lifecycle-viewmodel",
        "androidx.savedstate_savedstate",
    ],
    kotlincflags: [
        "-opt-in=kotlin.Experimental",
        "-opt-in=kotlin.ExperimentalStdlibApi",
    ],
    plugins: [
        "dagger2-compiler",
    ],

    required: [
        "ANGLE",
        "privapp_whitelist_com.android.gamespace.xml"
    ],
}

prebuilt_etc_xml {
    name: "privapp_whitelist_com.android.gamespace.xml",
    src: "privapp_whitelist_com.android.gamespace.xml",
    system_ext_specific: true,
    filename_from_src: true,
    sub_dir: "permissions",
}
